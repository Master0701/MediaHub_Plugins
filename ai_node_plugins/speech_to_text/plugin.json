{
  "id": "mediahub.speech_to_text",
  "name": "MediaHub Speech-to-Text",
  "version": "0.1.3",
  "type": "worker",
  "entrypoint": "plugin:MediaHubSpeechToTextPlugin",
  "api_version": "1",
  "description": "Lokale Speech-to-Text-Ausführung für MediaHub AI- und Compute-Nodes.",
  "author": "Master0701",
  "license": "MIT",
  "enabled_by_default": true,
  "permissions": [],
  "capabilities": [
    "speech_to_text"
  ],
  "job_types": [
    "speech_to_text"
  ],
  "dependencies": [
    {
      "id": "mediahub.python_runtime",
      "minimum_version": "0.1.0",
      "targets": [
        "windows_compute"
      ]
    }
  ],
  "required_tools": [],
  "targets": [
    "raspberry_pi",
    "windows_compute"
  ],
  "platforms": [
    "linux-aarch64",
    "windows-amd64"
  ],
  "required_capabilities": [],
  "execution": {
    "modes": [
      "auto",
      "cpu",
      "gpu"
    ],
    "cpu_threads_configurable": true,
    "accelerator_selection": true
  },
  "runtime": {
    "isolated": true,
    "engine": "faster-whisper",
    "dependencies": [
      "faster-whisper==1.2.1",
      "av==16.0.1"
    ],
    "models_directory": "models",
    "cache_directory": "cache",
    "cuda_dependencies": [
      "nvidia-cublas-cu12==12.6.4.1",
      "nvidia-cudnn-cu12==9.10.2.21",
      "nvidia-cuda-runtime-cu12==12.6.77"
    ]
  }
}
