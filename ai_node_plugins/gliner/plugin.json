{
  "id": "mediahub.gliner",
  "name": "MediaHub GLiNER",
  "version": "0.1.3",
  "type": "worker",
  "entrypoint": "plugin:MediaHubGLiNERPlugin",
  "api_version": "1",
  "description": "Lokale semantische Entitaets- und Identitaetserkennung fuer den MediaHub-KI-Assistenten.",
  "author": "Master0701",
  "license": "MIT",
  "enabled_by_default": true,
  "permissions": [],
  "capabilities": [
    "text_entity_extraction",
    "semantic_text_analysis"
  ],
  "job_types": [
    "text_entity_extraction"
  ],
  "dependencies": [
    {
      "id": "mediahub.python_runtime",
      "minimum_version": "0.1.0",
      "targets": [
        "windows_compute"
      ]
    }
  ],
  "required_tools": [],
  "targets": [
    "raspberry_pi",
    "windows_compute"
  ],
  "platforms": [
    "linux-aarch64",
    "windows-amd64"
  ],
  "required_capabilities": [],
  "execution": {
    "modes": [
      "auto",
      "cpu",
      "gpu"
    ],
    "cpu_threads_configurable": true,
    "accelerator_selection": true
  },
  "runtime": {
    "isolated": true,
    "engine": "gliner",
    "dependencies": [
      "gliner==0.2.29",
      "transformers>=4.51.3,<5.17.0",
      "protobuf",
      "tiktoken"
    ],
    "models_directory": "models",
    "cache_directory": "cache"
  },
  "model": {
    "repository": "urchade/gliner_multi-v2.1",
    "directory": "gliner_multi-v2.1",
    "installation": "during_plugin_install",
    "offline_runtime": true,
    "required_files": [
      "gliner_config.json"
    ],
    "weight_files": [
      "model.safetensors",
      "pytorch_model.bin"
    ],
    "offline_loader": "gliner"
  }
}
