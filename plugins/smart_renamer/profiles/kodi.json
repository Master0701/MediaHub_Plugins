        "movie"
      ],
      "schema_order": [
        "[titel]",
        "[jahr]"
      ]
    },
    {
      "type": "schema",
      "template": "[titel] - S[staffel]E[episode] - [episodentitel]",
      "label": "Kodi-Serienschema",
      "source": "profile",
      "media_types": [
        "series"
      ],
      "schema_order": [
        "[titel]",
        "S[staffel]E[episode]",
        "[episodentitel]"
      ]
    }
  ]
}
