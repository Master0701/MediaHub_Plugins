{
  "id": "mediahub.ai_assistant",
  "name": "MediaHub KI-Assistent",
  "version": "1.7.0",
  "author": "Master0701",
  "description": "Lokaler MediaHub-KI-Assistent mit Mehrquellen- und In-Video-Erkennung, erklärbarer Decision Engine, lokaler Fingerprint-Referenzdatenbank, Qualitätsbewertung und stabiler Übergabe-API für Metadata Editor und Universal Renamer.",
  "type": "tool",
  "enabled": true,
  "entry": "plugin.py",
  "icon": "",
  "safe_mode": true,
  "minimum_mediahub_version": "1.0.17",
  "minimum_mediahub": "1.0.17",
  "shared_runtime": "mediahub_web_core",
  "network_scope": "internet_optional",
  "class_name": "MediaHubAIAssistantPlugin",
  "permissions": [
    "read_library",
    "read_system",
    "read_plugins",
    "database.mediahub.read",
    "database.knowledge.read_write",
    "filesystem.media.read",
    "network.local",
    "network.internet"
  ],
  "has_settings": true,
  "ui": {
    "enabled": true,
    "type": "window",
    "title": "KI-Assistent",
    "icon": "",
    "order": 40,
    "web": {
      "enabled": true,
      "title": "KI-Assistent",
      "route": "/ai-assistant",
      "icon": "",
      "order": 40,
      "shell": false
    }
  },
  "required_tools": [
    {
      "id": "ffmpeg",
      "required": true,
      "provided_by": "mediahub"
    },
    {
      "id": "ffprobe",
      "required": true,
      "provided_by": "mediahub"
    },
    {
      "id": "mediainfo",
      "required": true,
      "provided_by": "mediahub_tool_manager"
    },
    {
      "id": "mkvtoolnix",
      "required": false,
      "provided_by": "mediahub_tool_manager",
      "feature": "mkv_analysis_and_editing"
    },
    {
      "id": "tesseract",
      "required": false,
      "provided_by": "mediahub_tool_manager",
      "feature": "ocr"
    }
  ],
  "capabilities": [
    "agent_availability",
    "agent_management",
    "agent_registry",
    "ai_node_diagnostics",
    "ai_node_latency",
    "ai_node_preparation",
    "ai_node_system_status",
    "atomic_knowledge_graph_storage",
    "backend_management",
    "cached_reasoning_refresh",
    "capability_based_planning",
    "capability_management",
    "chronological_order",
    "cross_media_type_search",
    "custom_order",
    "evidence_based_source_selection",
    "explainable_execution_plan",
    "feature_tool_mapping",
    "friendly_capability_labels",
    "knowledge_compatibility_api",
    "knowledge_demo_seed",
    "knowledge_graph",
    "knowledge_item_listing",
    "knowledge_schema_initialization",
    "knowledge_statistics",
    "live_backend_refresh",
    "local_fallback",
    "local_orchestration",
    "media_relations",
    "mediahub_ai_node_settings",
    "multi_query_provider_search",
    "multi_query_self_check",
    "ocr_title_filtering",
    "parallel_agent_preparation",
    "parallel_legacy_knowledge_database",
    "parallel_provider_execution",
    "provider_diagnostics",
    "provider_multi_query_execution",
    "provider_registry",
    "provider_result_cache",
    "release_order",
    "search_variant_reasoning",
    "source_plan_query_reuse",
    "task_execution",
    "task_planning",
    "technical_token_filtering",
    "tool_availability",
    "unknown_media_online_lookup",
    "variant_attributed_results",
    "variant_result_attribution",
    "visible_capability_status",
    "watch_order"
  ]
}
